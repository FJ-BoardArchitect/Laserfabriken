# Build output
build/

# STM32CubeMX generated (keep .ioc but ignore backups)
*.ioc.bak

# VS Code
.vscode/

# Compiler artifacts
*.o
*.d
*.su
*.elf
*.bin
*.hex
*.map

# stlink dev-testing tools (--target=stlink only, not customer-facing --
# see Tools/firmware-updater/FIRMWARE_UPDATER.md §5/§8) -- kept locally
# for convenience, deliberately not git-tracked like dist/'s dfu-util.exe is
Tools/firmware-updater/dist/st-flash.exe
Tools/firmware-updater/dist/libstlink.dll
Tools/firmware-updater/dist/libusb-1.0.dll

# System
.DS_Store
Thumbs.db

# CubeMX regenerates these next to each board's .ioc (boards/<board>/). Only
# boards/<board>/Core/ is used by the build; Drivers/, Middlewares/ and
# USB_Device/ are shared from the repo root and must not be duplicated.
boards/*/Drivers/
boards/*/Middlewares/
boards/*/USB_Device/
boards/*/cmake/
boards/*/CMakeLists.txt
boards/*/CMakePresets.json
boards/*/startup_stm32g431xx.s
boards/*/STM32G431XX_FLASH.ld
Tools/rtt-cli/__pycache__/
